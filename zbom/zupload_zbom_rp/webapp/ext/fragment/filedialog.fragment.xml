<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form" xmlns:u="sap.ui.unified" xmlns="sap.m"
>
<Dialog id="idFileUploadDialog" title="Upload Excel" >
    <VBox id="idVBox" width="100%">
        <f:SimpleForm id="idSimpleForm" editable="true" layout="ResponsiveGridLayout" maxContainerCols="2">
            <f:content>
                <Label id="idFileUploadLabel" required="true" text="Choose Excel File"/>
                <u:FileUploader id="idFileUpload" name="internalMailFileUpload" change="onFileChange" width="100%"
                 style="Emphasized" fileType="xls,xlsx" placeholder="select Excel File"
                />
            </f:content>
        </f:SimpleForm>
    </VBox>
    <footer>
        <Toolbar id="idToolbar">
            <content>
                <Button id="idUploadButton" text="Upload" type="Emphasized" press="onUploadPress" icon="sap-icon://upload"/>
                <Button id="idCancelButton" text="Cancel" press="onCancelUpload" icon="sap-icon://cancel"/>
            </content>
        </Toolbar>
    </footer>
</Dialog>

</core:FragmentDefinition>