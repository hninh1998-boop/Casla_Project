{
  "_version": "1.80.0",
  "sap.app": {
    "id": "zhhdvov4",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.30.0",
      "toolsId": "287b189d-8887-4801-b5c6-4c22b0b3721d"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_hhdv_ov4/srvd/sap/zui_hhdv/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "zhhdv_ov4-display": {
          "semanticObject": "zhhdv_ov4",
          "action": "display",
          "title": "{{zhhdv_ov4-display.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.142.12",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "zhhdvov4.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "HHDVHeadList",
          "target": "HHDVHeadList"
        },
        {
          "pattern": "HHDVHead({key}):?query:",
          "name": "HHDVHeadObjectPage",
          "target": "HHDVHeadObjectPage"
        },
        {
          "pattern": "HHDVHead({key})/_Item({key2}):?query:",
          "name": "HHDVItemObjectPage",
          "target": "HHDVItemObjectPage"
        }
      ],
      "targets": {
        "HHDVHeadList": {
          "type": "Component",
          "id": "HHDVHeadList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/HHDVHead",
              "variantManagement": "Page",
              "navigation": {
                "HHDVHead": {
                  "detail": {
                    "route": "HHDVHeadObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "GridTable"
                  },
                  "actions": {
                    "LayDuLieu": {
                      "press": ".extension.zhhdvov4.ext.controller.LayDuLieu.idLayDuLieu",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "Lấy dữ liệu"
                    },
                    "UdtInvoiceStatus": {
                      "press": ".extension.zhhdvov4.ext.controller.LayDuLieu.idUdtInvoiceStatus",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "Cập nhật trạng thái"
                    }
                  }
                }
              }
            }
          }
        },
        "HHDVHeadObjectPage": {
          "type": "Component",
          "id": "HHDVHeadObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/HHDVHead",
              "navigation": {
                "_Item": {
                  "detail": {
                    "route": "HHDVItemObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "_Item/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "GridTable"
                  }
                }
              }
            }
          }
        },
        "HHDVItemObjectPage": {
          "type": "Component",
          "id": "HHDVItemObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/HHDVHead/_Item"
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "zhhdvov4.ext.controller.LayDuLieu"
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
