<mvc:View
    controllerName="zmb51nov4.controller.Detail"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:form="sap.ui.layout.form"
>
    <Page id="detailPage" title="{i18n>detail.pageTitle}" showNavButton="true" navButtonPress=".onNavBack">
        <content>
            <!-- Form fields built at runtime from @UI.LineItem -->
            <form:SimpleForm
                id="detailForm"
                editable="false"
                layout="ResponsiveGridLayout"
                labelSpanXL="4"
                labelSpanL="4"
                labelSpanM="4"
                labelSpanS="12"
                columnsXL="2"
                columnsL="2"
                columnsM="1"
            />
        </content>
    </Page>
</mvc:View>
