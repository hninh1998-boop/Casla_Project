          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_ngc_stock/srvd/sap/zsd_ngc_stock_custome/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "ZSO_Subcontractor_Stock-display": {
          "semanticObject": "ZSO_Subcontractor_Stock",
          "action": "display",
          "title": "{{ZSO_Subcontractor_Stock-display.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.142.12",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "baocaonxtnvlnhagiacong.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ZCE_NGC_STOCK_CUSTOMList",
          "target": "ZCE_NGC_STOCK_CUSTOMList"
        },
        {
          "pattern": "ZCE_NGC_STOCK_CUSTOM({key}):?query:",
          "name": "ZCE_NGC_STOCK_CUSTOMObjectPage",
          "target": "ZCE_NGC_STOCK_CUSTOMObjectPage"
        }
      ],
      "targets": {
        "ZCE_NGC_STOCK_CUSTOMList": {
          "type": "Component",
          "id": "ZCE_NGC_STOCK_CUSTOMList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ZCE_NGC_STOCK_CUSTOM",
              "variantManagement": "Page",
              "navigation": {
                "ZCE_NGC_STOCK_CUSTOM": {
                  "detail": {
                    "route": "ZCE_NGC_STOCK_CUSTOMObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "GridTable"
                  },
                  "actions": {
                    "ExportExcel": {
                      "press": "baocaonxtnvlnhagiacong.ext.controller.ExportExcel.ExportExcel",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "Export Excel"
                    }
                  }
                }
              }
            }
          }
        },
        "ZCE_NGC_STOCK_CUSTOMObjectPage": {
          "type": "Component",
          "id": "ZCE_NGC_STOCK_CUSTOMObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ZCE_NGC_STOCK_CUSTOM"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
