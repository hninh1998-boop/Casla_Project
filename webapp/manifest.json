{
  "_version": "1.80.0",
  "sap.app": {
    "id": "mfgordoperwc",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.30.0",
      "toolsId": "b1dd1d46-4626-4b1a-a882-0f61324d88bc"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_mfgord_oper_wc/srvd/sap/zsd_mfgord_oper_wc/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "ZSO_XNSL_SM_LSX-display": {
          "semanticObject": "ZSO_XNSL_SM_LSX",
          "action": "display",
          "title": "{{ZSO_XNSL_SM_LSX-display.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.142.12",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "mfgordoperwc.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ZR_MFGORD_OPER_WCList",
          "target": "ZR_MFGORD_OPER_WCList"
        },
        {
          "pattern": "ZR_MFGORD_OPER_WC({key}):?query:",
          "name": "ZR_MFGORD_OPER_WCObjectPage",
          "target": "ZR_MFGORD_OPER_WCObjectPage"
        }
      ],
      "targets": {
        "ZR_MFGORD_OPER_WCList": {
          "type": "Component",
          "id": "ZR_MFGORD_OPER_WCList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ZR_MFGORD_OPER_WC",
              "variantManagement": "Page",
              "navigation": {
                "ZR_MFGORD_OPER_WC": {
                  "detail": {
                    "route": "ZR_MFGORD_OPER_WCObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  },
                  "actions": {
                    "PDF": {
                      "press": ".extension.mfgordoperwc.ext.controller.PDF.btnPrintPDF",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": true,
                      "text": "View PDF"
                    }
                  }
                }
              }
            }
          }
        },
        "ZR_MFGORD_OPER_WCObjectPage": {
          "type": "Component",
          "id": "ZR_MFGORD_OPER_WCObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ZR_MFGORD_OPER_WC"
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController#mfgordoperwc::ZR_MFGORD_OPER_WCList": {
            "controllerName": "mfgordoperwc.ext.controller.PDF"
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
