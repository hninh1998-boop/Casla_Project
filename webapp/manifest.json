{
  "_version": "1.86.0",
  "sap.app": {
    "id": "managerole",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.32.0",
      "toolsId": "a178e6bb-8ccb-41ac-96b6-d0196aec1a34"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_mob_rbac_adm_o4/srvd/sap/zui_mob_rbac_adm/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "ZSO_ROLE_XNSL-display": {
          "semanticObject": "ZSO_ROLE_XNSL",
          "action": "display",
          "title": "{{ZSO_ROLE_XNSL-display.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.148.8",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "managerole.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "RolesList",
          "target": "RolesList"
        },
        {
          "pattern": "Roles({key}):?query:",
          "name": "RolesObjectPage",
          "target": "RolesObjectPage"
        },
        {
          "pattern": "Roles({key})/_Functions({key2}):?query:",
          "name": "RoleFunctionsObjectPage",
          "target": "RoleFunctionsObjectPage"
        },
        {
          "pattern": "Roles({key})/_WorkAssignments({key2}):?query:",
          "name": "RoleWorkAssignmentsObjectPage",
          "target": "RoleWorkAssignmentsObjectPage"
        }
      ],
      "targets": {
        "RolesList": {
          "type": "Component",
          "id": "RolesList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Roles",
              "variantManagement": "Page",
              "navigation": {
                "Roles": {
                  "detail": {
                    "route": "RolesObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "GridTable"
                  }
                }
              }
            }
          }
        },
        "RolesObjectPage": {
          "type": "Component",
          "id": "RolesObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Roles",
              "navigation": {
                "_Functions": {
                  "detail": {
                    "route": "RoleFunctionsObjectPage"
                  }
                },
                "_WorkAssignments": {
                  "detail": {
                    "route": "RoleWorkAssignmentsObjectPage"
                  }
                }
              }
            }
          }
        },
        "RoleFunctionsObjectPage": {
          "type": "Component",
          "id": "RoleFunctionsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Roles/_Functions"
            }
          }
        },
        "RoleWorkAssignmentsObjectPage": {
          "type": "Component",
          "id": "RoleWorkAssignmentsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Roles/_WorkAssignments"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
