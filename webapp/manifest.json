{
  "_version": "1.80.0",
  "sap.app": {
    "id": "mcofaupl",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.30.0",
      "toolsId": "5a74062f-599d-4c4d-beb0-2c18d88ee900"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_m_mco_fa_upl/srvd/sap/zsd_m_mco_fa_upl/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "ZSO_MCO_FA_UPL-display": {
          "semanticObject": "ZSO_MCO_FA_UPL",
          "action": "display",
          "title": "{{ZSO_MCO_FA_UPL-display.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.142.12",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "mcofaupl.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ManageFileList",
          "target": "ManageFileList"
        },
        {
          "pattern": "ManageFile({key}):?query:",
          "name": "ManageFileObjectPage",
          "target": "ManageFileObjectPage"
        },
        {
          "pattern": "ManageFile({key})/_Data({key2}):?query:",
          "name": "DataObjectPage",
          "target": "DataObjectPage"
        }
      ],
      "targets": {
        "ManageFileList": {
          "type": "Component",
          "id": "ManageFileList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ManageFile",
              "variantManagement": "Page",
              "navigation": {
                "ManageFile": {
                  "detail": {
                    "route": "ManageFileObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  },
                  "actions": {
                    "UploadFile": {
                      "press": ".extension.mcofaupl.ext.controller.UploadExcelExt.uploadexceldialog",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "Upload"
                    }
                  }
                }
              }
            }
          }
        },
        "ManageFileObjectPage": {
          "type": "Component",
          "id": "ManageFileObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ManageFile",
              "navigation": {
                "_Data": {
                  "detail": {
                    "route": "DataObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "_Data/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "GridTable",
                    "selectAll": true,
                    "rowCountMode": "Auto",
                    "selectionMode": "Multi",
                    "enableMassEdit": false
                  }
                }
              }
            }
          }
        },
        "DataObjectPage": {
          "type": "Component",
          "id": "DataObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ManageFile/_Data"
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController#mcofaupl::ManageFileList": {
            "controllerName": "mcofaupl.ext.controller.UploadExcelExt"
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
