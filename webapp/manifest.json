{
  "_version": "1.80.0",
  "sap.app": {
    "id": "zmassprov4",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.29.0",
      "toolsId": "1da0e249-2e26-438c-9e32-2549dff49c1a"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_m_mass_pr_ov4/srvd/sap/zui_m_mass_pr/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "zmass_pr_ov2-display": {
          "semanticObject": "zmass_pr_ov2",
          "action": "display",
          "title": "{{zmass_pr_ov2-display.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.142.12",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "zmassprov4.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ManageFilePR1List",
          "target": "ManageFilePR1List"
        },
        {
          "pattern": "ManageFilePR1({key}):?query:",
          "name": "ManageFilePR1ObjectPage",
          "target": "ManageFilePR1ObjectPage"
        },
        {
          "pattern": "ManageFilePR1({key})/_DataFile({key2}):?query:",
          "name": "DataFilePR1ObjectPage",
          "target": "DataFilePR1ObjectPage"
        },
        {
          "pattern": "ManageFilePR2({key}):?query:",
          "name": "ManageFilePR2ObjectPage",
          "target": "ManageFilePR2ObjectPage"
        },
        {
          "pattern": "ManageFilePR2({key})/_DataFile({key2}):?query:",
          "name": "DataFilePR2ObjectPage",
          "target": "DataFilePR2ObjectPage"
        }
      ],
      "targets": {
        "ManageFilePR1List": {
          "type": "Component",
          "id": "ManageFilePR1List",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ManageFilePR1",
              "variantManagement": "Page",
              "navigation": {
                "ManageFilePR1": {
                  "detail": {
                    "route": "ManageFilePR1ObjectPage"
                  }
                },
                "ManageFilePR2": {
                  "detail": {
                    "route": "ManageFilePR2ObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "GridTable"
                  },
                  "actions": {
                    "idUploadExcelPR1": {
                      "press": ".extension.zmassprov4.ext.controller.ListReportExt.uploadExcelDialogPR1",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "Upload Excel"
                    }
                  }
                },
                "/ManageFilePR2/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "GridTable"
                  },
                  "actions": {
                    "idUploadExcelPR2": {
                      "press": ".extension.zmassprov4.ext.controller.ListReportExt.uploadExcelDialogPR2",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "Upload Excel"
                    }
                  }
                }
              },
              "views": {
                "paths": [
                  {
                    "key": "tableView",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#tableView"
                  },
                  {
                    "key": "ItemPR2",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#PR2",
                    "entitySet": "ManageFilePR2"
                  }
                ]
              }
            }
          }
        },
        "ManageFilePR1ObjectPage": {
          "type": "Component",
          "id": "ManageFilePR1ObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ManageFilePR1",
              "navigation": {
                "_DataFile": {
                  "detail": {
                    "route": "DataFilePR1ObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "_DataFile/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "GridTable"
                  }
                }
              }
            }
          }
        },
        "DataFilePR1ObjectPage": {
          "type": "Component",
          "id": "DataFilePR1ObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ManageFilePR1/_DataFile"
            }
          }
        },
        "ManageFilePR2ObjectPage": {
          "type": "Component",
          "id": "ManageFilePR2ObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ManageFilePR2",
              "navigation": {
                "_DataFile": {
                  "detail": {
                    "route": "DataFilePR2ObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "_DataFile/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "GridTable"
                  }
                }
              }
            }
          }
        },
        "DataFilePR2ObjectPage": {
          "type": "Component",
          "id": "DataFilePR2ObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ManageFilePR2/_DataFile"
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "zmassprov4.ext.controller.ListReportExt"
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}