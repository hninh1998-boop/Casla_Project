{
  "_version": "1.80.0",
  "sap.app": {
    "id": "workerxnsl",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.30.0",
      "toolsId": "2d0a4d5a-8f25-4da7-b3bc-83898112bee5"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_tb_kb_nhancong_qr/srvd/sap/zsd_tb_kb_nhancong_qr/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "ZSO_TK_KB_XNSL_SM_NV-display": {
          "semanticObject": "ZSO_TK_KB_XNSL_SM_NV",
          "action": "display",
          "title": "{{ZSO_TK_KB_XNSL_SM_NV-display.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.142.12",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "workerxnsl.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ZC_TB_KB_NHANCONG_QRList",
          "target": "ZC_TB_KB_NHANCONG_QRList"
        },
        {
          "pattern": "ZC_TB_KB_NHANCONG_QR({key}):?query:",
          "name": "ZC_TB_KB_NHANCONG_QRObjectPage",
          "target": "ZC_TB_KB_NHANCONG_QRObjectPage"
        }
      ],
      "targets": {
        "ZC_TB_KB_NHANCONG_QRList": {
          "type": "Component",
          "id": "ZC_TB_KB_NHANCONG_QRList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ZC_TB_KB_NHANCONG_QR",
              "variantManagement": "Page",
              "navigation": {
                "ZC_TB_KB_NHANCONG_QR": {
                  "detail": {
                    "route": "ZC_TB_KB_NHANCONG_QRObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  },
                  "actions": {
                    "PDF": {
                      "press": ".extension.workerxnsl.ext.controller.PDF.btnPrintPDF",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": true,
                      "text": "View PDF"
                    }
                  }
                }
              }
            }
          }
        },
        "ZC_TB_KB_NHANCONG_QRObjectPage": {
          "type": "Component",
          "id": "ZC_TB_KB_NHANCONG_QRObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ZC_TB_KB_NHANCONG_QR"
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController#workerxnsl::ZC_TB_KB_NHANCONG_QRList": {
            "controllerName": "workerxnsl.ext.controller.PDF"
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
