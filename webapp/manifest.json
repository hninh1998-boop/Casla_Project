{
  "_version": "1.80.0",
  "sap.app": {
    "id": "zmasspoov42",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.28.0",
      "toolsId": "3dc0c525-6b6a-4577-b06e-ef9acce61c30"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_m_mass_po_ov42/srvd/sap/zui_m_mass_po/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "zmass_po_ov42-display": {
          "semanticObject": "zmass_po_ov42",
          "action": "display",
          "title": "{{zmass_po_ov42-display.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.142.12",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "zmasspoov42.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ManageFilePOSubCompList",
          "target": "ManageFilePOSubCompList"
        },
        {
          "pattern": "ManageFilePOSubComp({key}):?query:",
          "name": "ManageFilePOSubCompObjectPage",
          "target": "ManageFilePOSubCompObjectPage"
        },
        {
          "pattern": "ManageFilePOSubComp({key})/_DataFile({key2}):?query:",
          "name": "DataFilePOSubCompObjectPage",
          "target": "DataFilePOSubCompObjectPage"
        },
        {
          "pattern": "ManageFilePOItem({key}):?query:",
          "name": "ManageFilePOItemObjectPage",
          "target": "ManageFilePOItemObjectPage"
        },
        {
          "pattern": "ManageFilePOItem({key})/_DataFile({key2}):?query:",
          "name": "DataFilePOItemObjectPage",
          "target": "DataFilePOItemObjectPage"
        }
      ],
      "targets": {
        "ManageFilePOSubCompList": {
          "type": "Component",
          "id": "ManageFilePOSubCompList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ManageFilePOSubComp",
              "variantManagement": "Page",
              "navigation": {
                "ManageFilePOSubComp": {
                  "detail": {
                    "route": "ManageFilePOSubCompObjectPage"
                  }
                },
                "ManageFilePOItem": {
                  "detail": {
                    "route": "ManageFilePOItemObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "GridTable"
                  },
                  "actions": {
                    "idUploadExcelSubComp": {
                      "press": ".extension.zmasspoov42.ext.controller.ListReportExt.uploadExcelDialogSubComp",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "Upload Excel"
                    }
                  }
                },
                "/ManageFilePOItem/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "GridTable"
                  },
                  "actions": {
                    "idUploadExcelItem": {
                      "press": ".extension.zmasspoov42.ext.controller.ListReportExt.uploadExcelDialogItem",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "Upload Excel"
                    }
                  }
                }
              },
              "views": {
                "paths": [
                  {
                    "key": "tableView",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#tableView"
                  },
                  {
                    "key": "Item",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#Item",
                    "entitySet": "ManageFilePOItem"
                  }
                ]
              }
            }
          }
        },
        "ManageFilePOSubCompObjectPage": {
          "type": "Component",
          "id": "ManageFilePOSubCompObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ManageFilePOSubComp",
              "navigation": {
                "_DataFile": {
                  "detail": {
                    "route": "DataFilePOSubCompObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "_DataFile/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "GridTable"
                  }
                }
              }
            }
          }
        },
        "DataFilePOSubCompObjectPage": {
          "type": "Component",
          "id": "DataFilePOSubCompObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ManageFilePOSubComp/_DataFile"
            }
          }
        },
        "ManageFilePOItemObjectPage": {
          "type": "Component",
          "id": "ManageFilePOItemObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ManageFilePOItem",
              "navigation": {
                "_DataFile": {
                  "detail": {
                    "route": "DataFilePOItemObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "_DataFile/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "GridTable"
                  }
                }
              }
            }
          }
        },
        "DataFilePOItemObjectPage": {
          "type": "Component",
          "id": "DataFilePOItemObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ManageFilePOItem/_DataFile"
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "zmasspoov42.ext.controller.ListReportExt"
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}