{
  "_version": "1.86.0",
  "sap.app": {
    "id": "zciov4",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.31.1",
      "toolsId": "c3465b49-c323-4933-baae-51689b14a6a9"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_ci_ov4/srvd/sap/zui_ci/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "zci_ov4-display": {
          "semanticObject": "zci_ov4",
          "action": "display",
          "title": "{{zci_ov4-display.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.148.8",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "zciov4.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "zce_ciList",
          "target": "zce_ciList"
        },
        {
          "pattern": "zce_ci({key}):?query:",
          "name": "zce_ciObjectPage",
          "target": "zce_ciObjectPage"
        }
      ],
      "targets": {
        "zce_ciList": {
          "type": "Component",
          "id": "zce_ciList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/zce_ci",
              "variantManagement": "Page",
              "navigation": {
                "zce_ci": {
                  "detail": {
                    "route": "zce_ciObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "GridTable"
                  },
                  "actions": {
                    "PDF": {
                      "press": ".extension.zciov4.ext.controller.PDF.btnPrintPDF",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": true,
                      "text": "Commercial Invoice"
                    },
                    "PackingList": {
                      "press": ".extension.zciov4.ext.controller.PDF.btnPrintPackingList",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": true,
                      "text": "Packing List"
                    }
                  }
                }
              }
            }
          }
        },
        "zce_ciObjectPage": {
          "type": "Component",
          "id": "zce_ciObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/zce_ci"
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController#zciov4::zce_ciList": {
            "controllerName": "zciov4.ext.controller.PDF"
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
