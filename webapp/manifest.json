{
  "_version": "1.80.0",
  "sap.app": {
    "id": "zudtbpbank",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.22.0",
      "toolsId": "f0a91a74-a7c5-46c4-93c1-bc64b0392408"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_bp_bank_account_v4/srvd/sap/zui_bp_bank_account/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "zudt_bp_bank-display": {
          "semanticObject": "zudt_bp_bank",
          "action": "display",
          "title": "{{zudt_bp_bank-display.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.142.10",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "zudtbpbank.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "UdtBpBankList",
          "target": "UdtBpBankList"
        },
        {
          "pattern": "UdtBpBank({key}):?query:",
          "name": "UdtBpBankObjectPage",
          "target": "UdtBpBankObjectPage"
        }
      ],
      "targets": {
        "UdtBpBankList": {
          "type": "Component",
          "id": "UdtBpBankList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/UdtBpBank",
              "variantManagement": "Page",
              "navigation": {
                "UdtBpBank": {
                  "detail": {
                    "route": "UdtBpBankObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "GridTable",
                    "selectionMode": "Single"
                  },
                  "actions": {
                    "idCrtBpBank": {
                      "press": ".extension.zudtbpbank.ext.controller.CrtUdtBpBank.onCreateBankPress",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "Create BP Bank"
                    },
                    "idUdtBpBank": {
                      "press": ".extension.zudtbpbank.ext.controller.CrtUdtBpBank.onUpdateBankPress",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": true,
                      "text": "Update BP Bank"
                    }
                  }
                }
              }
            }
          }
        },
        "UdtBpBankObjectPage": {
          "type": "Component",
          "id": "UdtBpBankObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/UdtBpBank"
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "zudtbpbank.ext.controller.CrtUdtBpBank"
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
