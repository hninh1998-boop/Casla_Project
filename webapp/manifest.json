{
  "_version": "1.80.0",
  "sap.app": {
    "id": "zcrtbatchov4",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.27.0",
      "toolsId": "9b3dba05-e1ec-403f-b219-e8e29b9bfc02"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_crt_batch_ov4/srvd/sap/zui_crt_batch/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "zcrt_batch_ov4-display": {
          "semanticObject": "zcrt_batch_ov4",
          "action": "display",
          "title": "{{zcrt_batch_ov4-display.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.142.12",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "zcrtbatchov4.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ManageFileList",
          "target": "ManageFileList"
        },
        {
          "pattern": "ManageFile({key}):?query:",
          "name": "ManageFileObjectPage",
          "target": "ManageFileObjectPage"
        },
        {
          "pattern": "ManageFile({key})/_DataFile({key2}):?query:",
          "name": "DataFileObjectPage",
          "target": "DataFileObjectPage"
        }
      ],
      "targets": {
        "ManageFileList": {
          "type": "Component",
          "id": "ManageFileList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ManageFile",
              "variantManagement": "Page",
              "navigation": {
                "ManageFile": {
                  "detail": {
                    "route": "ManageFileObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "GridTable",
                    "selectAll": true
                  },
                  "actions": {
                    "idUploadExcel": {
                      "press": ".extension.zcrtbatchov4.ext.controller.ExcelUploadExt.uploadexceldialog",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "Upload Excel"
                    }
                  }
                }
              }
            }
          }
        },
        "ManageFileObjectPage": {
          "type": "Component",
          "id": "ManageFileObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ManageFile",
              "controlConfiguration": {
                "_DataFile/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "GridTable",
                    "selectAll": true
                  }
                }
              },
              "navigation": {
                "_DataFile": {
                  "detail": {
                    "route": "DataFileObjectPage"
                  }
                }
              }
            }
          }
        },
        "DataFileObjectPage": {
          "type": "Component",
          "id": "DataFileObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ManageFile/_DataFile"
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "zcrtbatchov4.ext.controller.ExcelUploadExt"
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
