<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <MenuButton
        id="exportExcelMenuButton"
        text="Export"
        icon="sap-icon://excel-attachment"
        type="Transparent">
        <menu>
            <Menu id="_IDGenMenu">
                <MenuItem
                    id="menuItemTSCD1"
                    text="Tổng hợp"
                    press=".exportExcel">
                    <customData>
                        <core:CustomData key="formType" value="TSCD1"/>
                    </customData>
                </MenuItem>
                <MenuItem
                    id="menuItemTSCD2"
                    text="Nhóm hình cây"
                    press=".exportExcel">
                    <customData>
                        <core:CustomData key="formType" value="TSCD2"/>
                    </customData>
                </MenuItem>
            </Menu>
        </menu>
    </MenuButton>
</core:FragmentDefinition>