unmanaged implementation in class zbp_ce_ci unique;
strict ( 2 ); // bắt buộc để dùng side effects (tự refresh dòng sau Cập nhật thông tin in)

define behavior for zce_ci //alias <alias_name>
//late numbering
lock master
authorization master ( instance )
//etag master <field_name>
{
  //  create ( authorization : global );
  //  update;
  //  delete;
  field ( readonly ) ProFormaInvoice, Item;

  // Các mục FS ghi "Điền text" (Invoice#, MB/L, HB/L, ETA) - cấp header, lưu ztb_ci_text theo Pro-forma invoice
  // Nút Cập nhật thông tin in đặt ở manifest (PDF.controller.js) để sau khi lưu refresh lại cả bảng
  action updCIText parameter zabs_ci_text;

  action btnPrintPDF parameter zabs_ci_param result [1] zabs_ci_result;
  action PDFPackingList parameter zabs_ci_param result [1] zabs_ci_result;

  // Export Excel: file sinh hoàn toàn ở backend (zcl_ce_ci_xlsx), FE chỉ nhận file
  // zabs_ci_param: 10.HTS CODE / 12. user tích chọn ở popup trước khi in
  action ExportExcelCI parameter zabs_ci_param result [1] zabs_ci_result;
  action ExportExcelPL parameter zabs_ci_param result [1] zabs_ci_result;

  // Sau khi Cập nhật thông tin in, Fiori tự đọc lại các cột này của dòng vừa sửa (không phải bấm Go)
  side effects
  {
    action updCIText affects field Invoice, field MBL, field HBL, field ETA;
  }
}