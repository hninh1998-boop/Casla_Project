projection;
strict ( 2 );
use draft;
use side effects;

define behavior for zc_m_thung alias ManageFile
{
  //  use create;
  use update;
  use delete;

  use action uploadExcel;
  use action downloadTemplate;

  use action Activate;
  use action Discard;
  use action Edit;
  use action Resume;
  use action Prepare;

  use association _DataFile { create; with draft; }
}

define behavior for zc_d_thung alias DataFile
{
  use update;
  use delete;

  use action PostConfirm;

  use association _ManageFile { with draft; }
}
