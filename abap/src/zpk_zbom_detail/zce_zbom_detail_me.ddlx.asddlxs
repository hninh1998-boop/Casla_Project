@Metadata.layer: #PARTNER
@Consumption.semanticObject: 'DetailListZBOM'
@UI.headerInfo: {
    typeName: 'Explode Bills of Material',
    typeNamePlural: 'Bills of Materials',
    title: {
        label: 'Bill Of Material Component',
        valueQualifier: 'Component',
        value: 'BillOfMaterialComponent'
    },
    description: {
        label: 'Bill Of Material Component',
        valueQualifier: 'Component',
        value: 'ComponentDescription'
    }
}
annotate entity zce_zbom_detail with
{
  //  @UI.hidden: true
  @UI.selectionField: [{ position: 10 }]
  @Consumption.filter.hidden: true
  BillOfMaterial;

  //  @UI.hidden: true
  @UI.selectionField: [{ position: 50 }]
  @Consumption.filter.hidden: true
  BillOfMaterialVariantUsage;

  @UI.selectionField: [{ position: 30 }]
  @Consumption.filter.hidden: true
  Material;
  @UI.hidden: true
  BillOfMaterialVariant;
  @UI.hidden: true
  BillOfMaterialVersion;
  @UI.hidden: true
  BillOfMaterialItemNodeNumber;
  @UI.hidden: true
  HeaderChangeDocument;

  @UI.hidden: true
  ItemIndex;

  @EndUserText.label: 'BOM Level'
  @UI.lineItem:       [{ position: 10, label: 'BOM Level' }]
  @UI.identification: [{ position: 1, label: 'BOM Level' }]
  @UI.selectionField: [{ position: 90 }]
  BomExplosionLevel;

  @UI.lineItem:       [{ position: 20, label: 'Tree View' }]
  @UI.identification: [{ position: 2, label: 'Tree View' }]
  TreeView;

  @UI.lineItem:       [{ position: 30, label: 'Material' }]
  MaterialHeader;

  @EndUserText.label: 'Material Description'
  @UI.lineItem:       [{ position: 40, label: 'Material Description' }]
  MaterialDescription;

  @UI.lineItem:       [{ position: 50, label: 'Plant' }]
  @UI.identification: [{ position: 80, label: 'Plant' }]
  @UI.selectionField: [{ position: 40 }]
  @Consumption.filter.hidden: true
  Plant;

  @UI.lineItem:       [{ position: 60, label: 'BOM Category' }]
  @UI.selectionField: [{ position: 20 }]
  @Consumption.filter.hidden: true
  BillOfMaterialCategory;

  @UI.lineItem:       [{ position: 70, label: 'Sales Order' }]
  @UI.selectionField: [{ position: 60 }]
  @Consumption.filter.hidden: true
  SalesOrder;

  @UI.lineItem:       [{ position: 80, label: 'Sales Order Item' }]
  @UI.selectionField: [{ position: 70 }]
  @Consumption.filter.hidden: true
  SalesOrderItem;

  @UI.lineItem:       [{ position: 90, label: 'Required Quantity' }]
  @Consumption.filter.hidden: true
  RequiredQuantityHeader;

  @EndUserText.label: 'Component'
  @UI.lineItem:       [{ position: 100, label: 'Component' }]
  @UI.identification: [{ position: 10, label: 'Component' }]
  @UI.selectionField: [{ position: 80 }]
  BillOfMaterialComponent;


  @UI.lineItem:       [{ position: 110, label: 'Component Description' }]
  @UI.identification: [{ position: 20, label: 'Component Description' }]
  ComponentDescription;

  @UI.lineItem:       [{ position: 120, label: 'Component Quantity (Component UoM)' }]
  @UI.identification: [{ position: 30, label: 'Component Quantity (Component UoM)' }]
  BomCompQuant;

  @UI.lineItem:       [{ position: 130, label: 'Item Category' }]
  @UI.identification: [{ position: 40, label: 'Item Category' }]
  BillOfMaterialItemCategory;

  @UI.lineItem:       [{ position: 140, label: 'Item Number' }]
  @UI.identification: [{ position: 50, label: 'Item Number' }]
  BillOfMaterialItemNumber;

  @UI.lineItem:       [{ position: 150, label: 'Assembly Indicator' }]
  @UI.identification: [{ position: 60, label: 'Assembly Indicator' }]
  IsAssembly;

  @UI.lineItem:       [{ position: 160, label: 'Material Type' }]
  @UI.identification: [{ position: 70, label: 'Material Type' }]
  MaterialType;



  @UI.lineItem:       [{ position: 170, label: 'Base Unit of Measure' }]
  @UI.identification: [{ position: 90, label: 'Base Unit of Measure' }]
  BillOfMaterialItemUnit;

  @UI.lineItem:       [{ position: 180, label: 'Maintenance Status' }]
  @UI.identification: [{ position: 100, label: 'Maintenance Status' }]
  MaintenanceStatus;

  @UI.lineItem:       [{ position: 190, label: 'Valid From' }]
  @UI.identification: [{ position: 110, label: 'Valid From' }]
  ValidityStartDate;

  @UI.lineItem:       [{ position: 200, label: 'Change Number' }]
  @UI.identification: [{ position: 120, label: 'Change Number' }]
  ChangeNumber;

  @UI.lineItem:       [{ position: 210, label: 'Created On' }]
  @UI.identification: [{ position: 130, label: 'Created On' }]
  CreatedOn;

  @UI.lineItem:       [{ position: 220, label: 'Created By' }]
  @UI.identification: [{ position: 140, label: 'Created By' }]
  CreatedBy;

  @UI.lineItem:       [{ position: 230, label: 'Changed On' }]
  @UI.identification: [{ position: 150, label: 'Changed On' }]
  ChangedOn;

  @UI.lineItem:       [{ position: 240, label: 'Changed By' }]
  @UI.identification: [{ position: 160, label: 'Changed By' }]
  ChangedBy;

  @UI.lineItem:       [{ position: 250, label: 'Item Spare Part Indicator' }]
  @UI.identification: [{ position: 170, label: 'Item Spare Part Indicator' }]
  IsBomItemSparePart;

  @UI.lineItem:       [{ position: 260, label: 'Component Scrap in Percent' }]
  @UI.identification: [{ position: 180, label: 'Component Scrap in Percent' }]
  ComponentScrapInPercent;
}