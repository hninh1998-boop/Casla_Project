@Metadata.layer: #CORE
@UI.headerInfo: {
  typeName: 'OD Header Upload',
  typeNamePlural: 'OD Header Uploads',
  title: { value: 'Od' }
}
@UI.lineItem: [{ criticality: 'Criticality' }]
annotate entity zc_m_od_h_data with
{
  @UI.facet: [
    { id: 'General', type: #COLLECTION, label: 'General', position: 10 },
    { id: 'ChangeData', parentId: 'General', type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'ChangeData', label: 'OD Header Data', position: 10 },
    { id: 'Result', parentId: 'General', type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'Result', label: 'Processing Result', position: 20 }
  ]


  @UI.lineItem: [
           { label: 'Post Document',
             dataAction: 'PostConfirm',
             type: #FOR_ACTION,
             invocationGrouping: #CHANGE_SET
           }]
  @UI.hidden: true
  Uuid;

  @UI.hidden: true
  UuidFile;

  @UI.selectionField: [{ position: 10 }]
  @UI.lineItem: [{ position: 10, importance: #HIGH }]
  @UI.identification: [{ position: 10 }]
  @UI.fieldGroup: [{ qualifier: 'ChangeData', position: 10 }]
  @EndUserText.label: 'OD'
  Od;

  @UI.lineItem: [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  @UI.fieldGroup: [{ qualifier: 'ChangeData', position: 20 }]
  @EndUserText.label: 'Plan GI Date'
  PlanGiDate;

  @UI.lineItem: [{ position: 30 }]
  @UI.identification: [{ position: 30 }]
  @UI.fieldGroup: [{ qualifier: 'ChangeData', position: 30 }]
  @EndUserText.label: 'Inco. Vers'
  IncoVers;

  @UI.lineItem: [{ position: 40 }]
  @UI.identification: [{ position: 40 }]
  @UI.fieldGroup: [{ qualifier: 'ChangeData', position: 40 }]
  @EndUserText.label: 'Incoterm'
  Incoterm;

  @UI.lineItem: [{ position: 50 }]
  @UI.identification: [{ position: 50 }]
  @UI.fieldGroup: [{ qualifier: 'ChangeData', position: 50 }]
  @EndUserText.label: 'Inco. Loc1'
  IncoLoc1;

  @UI.lineItem: [{ position: 60 }]
  @UI.identification: [{ position: 60 }]
  @UI.fieldGroup: [{ qualifier: 'ChangeData', position: 60 }]
  @EndUserText.label: 'Inco. Loc2'
  IncoLoc2;

  @UI.lineItem: [{ position: 70 }]
  @UI.identification: [{ position: 70 }]
  @UI.fieldGroup: [{ qualifier: 'ChangeData', position: 70 }]
  @EndUserText.label: 'Nhà cung cấp vận tải'
  NhaCungCapVanTai;

  @UI.lineItem: [{ position: 80 }]
  @UI.identification: [{ position: 80 }]
  @UI.fieldGroup: [{ qualifier: 'ChangeData', position: 80 }]
  @EndUserText.label: 'Phân loại PTVT'
  PhanLoaiPtvt;

  @UI.lineItem: [{ position: 90 }]
  @UI.identification: [{ position: 90 }]
  @UI.fieldGroup: [{ qualifier: 'ChangeData', position: 90 }]
  @EndUserText.label: 'Số lượng PTVT'
  SoLuongPtvt;

  @UI.lineItem: [{ position: 100 }]
  @UI.identification: [{ position: 100 }]
  @UI.fieldGroup: [{ qualifier: 'ChangeData', position: 100 }]
  @EndUserText.label: 'Biển số xe'
  BienSoXe;

  @UI.lineItem: [{ position: 110 }]
  @UI.identification: [{ position: 110 }]
  @UI.fieldGroup: [{ qualifier: 'ChangeData', position: 110 }]
  @EndUserText.label: 'Số container'
  SoContainer;

  @UI.lineItem: [{ position: 120 }]
  @UI.identification: [{ position: 120 }]
  @UI.fieldGroup: [{ qualifier: 'ChangeData', position: 120 }]
  @EndUserText.label: 'Số seal'
  SoSeal;

  @UI.lineItem: [{ position: 130 }]
  @UI.identification: [{ position: 130 }]
  @UI.fieldGroup: [{ qualifier: 'ChangeData', position: 130 }]
  @EndUserText.label: 'Tare Weight'
  TareWeight;

  @UI.lineItem: [{ position: 140 }]
  @UI.identification: [{ position: 140 }]
  @UI.fieldGroup: [{ qualifier: 'ChangeData', position: 140 }]
  @EndUserText.label: 'Booking'
