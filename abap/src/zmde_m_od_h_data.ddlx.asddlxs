  @UI.lineItem: [{ position: 150 }]
  @UI.identification: [{ position: 150 }]
  @UI.fieldGroup: [{ qualifier: 'ChangeData', position: 150 }]
  @EndUserText.label: 'Ngày tàu chạy'
  NgayTauChay;

  @UI.lineItem: [{ position: 160 }]
  @UI.identification: [{ position: 160 }]
  @UI.fieldGroup: [{ qualifier: 'ChangeData', position: 160 }]
  @EndUserText.label: 'Ngày giờ xuất hàng'
  NgayGioXuatHang;

  @UI.lineItem: [{ position: 170 }]
  @UI.identification: [{ position: 170 }]
  @UI.fieldGroup: [{ qualifier: 'ChangeData', position: 170 }]
  @EndUserText.label: 'Cut-off Time'
  CutOffTime;

  @UI.lineItem: [{ position: 180 }]
  @UI.identification: [{ position: 180 }]
  @UI.fieldGroup: [{ qualifier: 'ChangeData', position: 180 }]
  @EndUserText.label: 'Ghi chú giao hàng'
