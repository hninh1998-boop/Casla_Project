  @UI.lineItem: [{ position: 190 }]
  @UI.identification: [{ position: 190 }]
  @UI.fieldGroup: [{ qualifier: 'ChangeData', position: 190 }]
  @EndUserText.label: 'Tỷ giá lô nội địa'
  TyGiaLoNoiDia;

  @UI.hidden: true
  HasPlanGiDate;
  @UI.hidden: true
  HasIncoVers;
  @UI.hidden: true
  HasIncoterm;
  @UI.hidden: true
  HasIncoLoc1;
  @UI.hidden: true
  HasIncoLoc2;
  @UI.hidden: true
  HasNhaCungCapVanTai;
  @UI.hidden: true
  HasPhanLoaiPtvt;
  @UI.hidden: true
  HasSoLuongPtvt;
  @UI.hidden: true
  HasBienSoXe;
  @UI.hidden: true
  HasSoContainer;
  @UI.hidden: true
  HasSoSeal;
  @UI.hidden: true
  HasTareWeight;
  @UI.hidden: true
  HasBooking;
  @UI.hidden: true
  HasNgayTauChay;
  @UI.hidden: true
  HasNgayGioXuatHang;
  @UI.hidden: true
  HasCutOffTime;
  @UI.hidden: true
  HasGhiChuGiaoHang;
  @UI.hidden: true
  HasTyGiaLoNoiDia;

  @UI.lineItem: [{ position: 200, importance: #HIGH, criticality: 'Criticality' }]
  @UI.identification: [{ position: 200 }]
  @UI.fieldGroup: [{ qualifier: 'Result', position: 10 }]
  @EndUserText.label: 'Result Type'
  @UI.dataPoint: { title: 'Result Type', criticality: 'Criticality' }
  MessageType;

  @Consumption.filter.hidden: true
  Criticality;

  @UI.hidden: true
  OverallStatusText;

  @UI.lineItem: [{ position: 210, importance: #HIGH }]
  @UI.identification: [{ position: 210 }]
  @UI.fieldGroup: [{ qualifier: 'Result', position: 20 }]
  @EndUserText.label: 'Result Message'
  Message;

  @UI.hidden: true
  CreatedBy;
  @UI.hidden: true
  CreatedAt;
  @UI.hidden: true
  LastChangedBy;
  @UI.hidden: true
  LastChangedAt;
}