@EndUserText.label : 'DB - Commercial Invoice Text'
@AbapCatalog.enhancement.category : #NOT_EXTENSIBLE
@AbapCatalog.tableCategory : #TRANSPARENT
@AbapCatalog.deliveryClass : #A
@AbapCatalog.dataMaintenance : #RESTRICTED
define table ztb_ci_text {

  key client   : mandt not null;
  key proforma : vbeln not null;
  key item     : posnr not null;
  invoice_no   : abap.string(0);
  mbl          : abap.string(0);
  hbl          : abap.string(0);
  eta          : abap.string(0);
  changed_by   : syuname;
  changed_at   : utcl;

}
